[{"id": "01", "text": "Competence everyone can see.", "voice": "bm_george", "speed": 0.9}, {"id": "02a", "text": "A hallmark told a buyer the metal was good, before anyone tested it.", "voice": "bm_george", "speed": 0.9}, {"id": "02b", "text": "A well-drawn mark does the same.", "voice": "bm_george", "speed": 0.9}, {"id": "03a", "text": "Can you see the difference?", "voice": "bm_george", "speed": 0.9}, {"id": "03b", "text": "Competence shows in the drawing.", "voice": "bm_george", "speed": 0.9}, {"id": "04", "text": "Tools are the easy part. We keep it actionable by keeping it simple. Clean vectors, not thirty-page rulebooks.", "voice": "bm_george", "speed": 0.9}, {"id": "05", "text": "Each one of a kind.", "voice": "bm_george", "speed": 0.9}, {"id": "06", "text": "Something to stand behind. Staff who are proud of it wear it, hand out the card, and defend the standard.", "voice": "bm_george", "speed": 0.9}, {"id": "07a", "text": "Raise the standard.", "voice": "bm_george", "speed": 0.9}, {"id": "07b", "text": "arvorealta dot com.", "voice": "bm_george", "speed": 0.9}]